# MBSI Library — Environment Variables
# ─────────────────────────────────────────────────────────────
# Local development uses SQLite (zero-setup, runs anywhere).
# To deploy on PostgreSQL, change the `provider` in
# prisma/schema.prisma to "postgresql" and set DATABASE_URL
# to your Postgres connection string. No other schema changes
# are required — the schema is fully provider-portable.
#
# Example PostgreSQL URL:
# DATABASE_URL="postgresql://user:password@localhost:5432/mbsi_library?schema=public"

DATABASE_URL="file:./dev.db"

# Secret used to sign session cookies. CHANGE THIS in production.
APP_SECRET="mbsi-library-dev-secret-change-me"

# Public base URL (used for absolute links / signed URLs)
APP_URL="http://localhost:3000"

# ── Optional: Meilisearch (falls back to DB search if unset) ──
# MEILI_HOST="http://localhost:7700"
# MEILI_API_KEY="masterKey"

# ── Optional: S3-compatible storage (falls back to local) ─────
# STORAGE_DRIVER="local"
# S3_BUCKET="mbsi-library"
# S3_REGION="eu-central-1"
# S3_ENDPOINT="https://s3.eu-central-1.amazonaws.com"
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# S3_PUBLIC_BASE_URL=""

# ── Optional: rate limiting (in-memory if unset) ─────────────
# RATE_LIMIT_MAX="100"
