// Prisma schema — MBSI Library
// ============================================================
// Datasource: PostgreSQL (works locally, on Vercel, on Neon).
// DATABASE_URL must point at a Postgres instance.
// Enums are stored as `String` so the schema stays portable.
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums (stored as String for provider portability) ──────
// USER.role        : STUDENT | TEACHER | ADMIN
// BOOK.language    : UZ | RU | EN

model User {
  id              String   @id @default(cuid())
  name            String
  role            String   @default("STUDENT") // STUDENT | TEACHER | ADMIN
  avatar          String?
  externalUserId  String?  @map("external_user_id") // future MBSI SSO link
  telegramId      String?  @unique @map("telegram_id") // Telegram bot link
  coins           Int      @default(0)
  balls           Float    @default(0) // Ball system (0-12)
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  progress          ReadingProgress[]
  sessions          ReadingSession[]
  bookmarks         Bookmark[]
  favorites         Favorite[]
  ratings           Rating[]
  reviews           Review[]
  readingGoals      ReadingGoal[]
  userMissions      UserMission[]
  auditLogs         AuditLog[]
  ballTransactions  BallTransaction[]

  @@index([role])
  @@index([isActive])
  @@map("users")
}

model Author {
  id          String   @id @default(cuid())
  name        String
  biography   String?
  avatar      String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  books Book[]

  @@map("authors")
}

model Category {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  icon        String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  books Book[]

  @@map("categories")
}

model Book {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  description String?
  coverUrl    String?  @map("cover_url")
  pdfUrl      String?  @map("pdf_url")
  language    String   @default("UZ") // UZ | RU | EN
  totalPages  Int      @default(0) @map("total_pages")
  fileSize    Int?     @map("file_size")
  coinReward  Int      @default(10) @map("coin_reward")
  authorId    String   @map("author_id")
  categoryId  String   @map("category_id")
  isPublished Boolean  @default(false) @map("is_published")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  author         Author           @relation(fields: [authorId], references: [id])
  category       Category         @relation(fields: [categoryId], references: [id])
  progress       ReadingProgress[]
  sessions       ReadingSession[]
  bookmarks      Bookmark[]
  favorites      Favorite[]
  ratings        Rating[]
  reviews        Review[]
  recommendations Recommendation[]
  content        BookContent?

  @@index([title])
  @@index([authorId])
  @@index([categoryId])
  @@index([language])
  @@index([isPublished])
  @@map("books")
}

model ReadingProgress {
  id          String    @id @default(cuid())
  userId      String    @map("user_id")
  bookId      String    @map("book_id")
  currentPage Int       @default(0) @map("current_page")
  progress    Float     @default(0) // 0-100
  startedAt   DateTime  @default(now()) @map("started_at")
  lastReadAt  DateTime  @default(now()) @map("last_read_at")
  completedAt DateTime? @map("completed_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@unique([userId, bookId])
  @@index([userId])
  @@index([bookId])
  @@map("reading_progress")
}

model ReadingSession {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  bookId    String   @map("book_id")
  startPage Int      @map("start_page")
  baselinePage Int   @default(0) @map("baseline_page") // max page reached before this session
  endPage   Int      @default(0) @map("end_page")
  pagesRead Int      @default(0) @map("pages_read")
  duration  Int      @default(0) // seconds
  startedAt DateTime @default(now()) @map("started_at")
  endedAt   DateTime? @map("ended_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([bookId])
  @@index([startedAt])
  @@map("reading_sessions")
}

model Bookmark {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  bookId    String   @map("book_id")
  page      Int
  note      String?
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@unique([userId, bookId, page])
  @@index([userId])
  @@index([bookId])
  @@map("bookmarks")
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  bookId    String   @map("book_id")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@unique([userId, bookId])
  @@index([userId])
  @@map("favorites")
}

model Rating {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  bookId    String   @map("book_id")
  rating    Int // 1-5
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@unique([userId, bookId])
  @@index([bookId])
  @@map("ratings")
}

model Review {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  bookId    String   @map("book_id")
  rating    Int // 1-5
  text      String
  isHidden  Boolean  @default(false) @map("is_hidden")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@unique([userId, bookId])
  @@index([bookId])
  @@index([isHidden])
  @@map("reviews")
}

model ReadingGoal {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  type      String // BOOKS_PER_MONTH | MINUTES_PER_DAY
  target    Int
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type])
  @@map("reading_goals")
}

model Mission {
  id          String   @id @default(cuid())
  title       String
  description String?
  targetType  String   // PAGES | BOOKS
  target      Int
  reward      Int      @default(10)
  startDate   DateTime @map("start_date")
  endDate     DateTime @map("end_date")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  userMissions UserMission[]

  @@map("missions")
}

model UserMission {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  missionId String   @map("mission_id")
  claimedAt DateTime @default(now()) @map("claimed_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  mission Mission @relation(fields: [missionId], references: [id], onDelete: Cascade)

  @@unique([userId, missionId])
  @@map("user_missions")
}

model Banner {
  id          String   @id @default(cuid())
  title       String
  description String?
  imageUrl    String?  @map("image_url")
  link        String?
  order       Int      @default(0)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("banners")
}

model Recommendation {
  id          String   @id @default(cuid())
  title       String
  description String?
  bookId      String   @map("book_id")
  order       Int      @default(0)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")

  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@index([bookId])
  @@map("recommendations")
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?  @map("user_id")
  action    String
  entity    String
  entityId  String
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([createdAt])
  @@map("audit_logs")
}

// Binary files (PDFs, covers uploaded at runtime). Stored in the
// database so uploads survive on read-only serverless hosts.
model StoredFile {
  id        String   @id @default(cuid())
  key       String   @unique
  mime      String
  size      Int
  data      Bytes
  createdAt DateTime @default(now()) @map("created_at")

  @@map("stored_files")
}

model BookContent {
  id              String   @id @default(cuid())
  bookId          String   @unique @map("book_id")
  extractedText   String?  @map("extracted_text") @db.Text
  translatedText  String?  @map("translated_text") @db.Text
  summary         String?  @db.Text
  keyPoints       Json?    @map("key_points")
  highlights      Json?
  tableOfContents Json?    @map("table_of_contents")
  keyTerms        Json?    @map("key_terms")
  extractedImages Json?    @map("extracted_images") // [{page, index, dataUrl, width, height, offsetX, offsetY, caption?}]
  status          String   @default("pending") // pending | processing | completed | error
  errorMessage    String?  @map("error_message")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@index([bookId])
  @@map("book_contents")
}

// Ball transaction history - tracks all +/− ball changes
model BallTransaction {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  amount      Float    // +0.3, -0.5, +1, -2 etc.
  balance     Float    // balance after this transaction
  type        String   // BOOK_READ | MISSION_COMPLETE | MISSION_PENALTY | ADMIN_GIVE | ADMIN_TAKE | MANUAL
  description String?
  referenceId String?  @map("reference_id") // bookId, missionId etc.
  createdAt   DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@map("ball_transactions")
}
