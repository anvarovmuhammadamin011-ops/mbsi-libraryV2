// Prisma schema — MBSI Library
// ============================================================
// Datasource: PostgreSQL (works locally, on Vercel, on Neon).
// DATABASE_URL must point at a Postgres instance.
// Enums are stored as `String` so the schema stays portable.
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums (stored as String for provider portability) ──────
// USER.role        : STUDENT | TEACHER | ADMIN
// BOOK.language    : UZ | RU | EN

model User {
  id              String   @id @default(cuid())
  name            String
  role            String   @default("STUDENT") // STUDENT | TEACHER | ADMIN
  avatar          String?
  externalUserId  String?  @map("external_user_id") // future MBSI SSO link
  telegramId      String?  @unique @map("telegram_id") // Telegram bot link
  coins           Int      @default(0)
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  progress    ReadingProgress[]
  sessions    ReadingSession[]
  bookmarks   Bookmark[]
  favorites   Favorite[]
  ratings     Rating[]
  auditLogs   AuditLog[]

  @@index([role])
  @@index([isActive])
  @@map("users")
}

model Author {
  id          String   @id @default(cuid())
  name        String
  biography   String?
  avatar      String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  books Book[]

  @@map("authors")
}

model Category {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  icon        String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  books Book[]

  @@map("categories")
}

model Book {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  description String?
  coverUrl    String?  @map("cover_url")
  pdfUrl      String?  @map("pdf_url")
  language    String   @default("UZ") // UZ | RU | EN
  totalPages  Int      @default(0) @map("total_pages")
  fileSize    Int?     @map("file_size")
  coinReward  Int      @default(10) @map("coin_reward")
  authorId    String   @map("author_id")
  categoryId  String   @map("category_id")
  isPublished Boolean  @default(false) @map("is_published")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  author         Author           @relation(fields: [authorId], references: [id])
  category       Category         @relation(fields: [categoryId], references: [id])
  progress       ReadingProgress[]
  sessions       ReadingSession[]
  bookmarks      Bookmark[]
  favorites      Favorite[]
  ratings        Rating[]
  recommendations Recommendation[]

  @@index([title])
  @@index([authorId])
  @@index([categoryId])
  @@index([language])
  @@index([isPublished])
  @@map("books")
}

model ReadingProgress {
  id          String    @id @default(cuid())
  userId      String    @map("user_id")
  bookId      String    @map("book_id")
  currentPage Int       @default(0) @map("current_page")
  progress    Float     @default(0) // 0-100
  startedAt   DateTime  @default(now()) @map("started_at")
  lastReadAt  DateTime  @default(now()) @map("last_read_at")
  completedAt DateTime? @map("completed_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@unique([userId, bookId])
  @@index([userId])
  @@index([bookId])
  @@map("reading_progress")
}

model ReadingSession {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  bookId    String   @map("book_id")
  startPage Int      @map("start_page")
  baselinePage Int   @default(0) @map("baseline_page") // max page reached before this session
  endPage   Int      @default(0) @map("end_page")
  pagesRead Int      @default(0) @map("pages_read")
  duration  Int      @default(0) // seconds
  startedAt DateTime @default(now()) @map("started_at")
  endedAt   DateTime? @map("ended_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([bookId])
  @@index([startedAt])
  @@map("reading_sessions")
}

model Bookmark {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  bookId    String   @map("book_id")
  page      Int
  note      String?
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@unique([userId, bookId, page])
  @@index([userId])
  @@index([bookId])
  @@map("bookmarks")
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  bookId    String   @map("book_id")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@unique([userId, bookId])
  @@index([userId])
  @@map("favorites")
}

model Rating {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  bookId    String   @map("book_id")
  rating    Int // 1-5
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@unique([userId, bookId])
  @@index([bookId])
  @@map("ratings")
}

model Banner {
  id          String   @id @default(cuid())
  title       String
  description String?
  imageUrl    String?  @map("image_url")
  link        String?
  order       Int      @default(0)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("banners")
}

model Recommendation {
  id          String   @id @default(cuid())
  title       String
  description String?
  bookId      String   @map("book_id")
  order       Int      @default(0)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")

  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@index([bookId])
  @@map("recommendations")
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?  @map("user_id")
  action    String
  entity    String
  entityId  String
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([createdAt])
  @@map("audit_logs")
}

// Binary files (PDFs, covers uploaded at runtime). Stored in the
// database so uploads survive on read-only serverless hosts.
model StoredFile {
  id        String   @id @default(cuid())
  key       String   @unique
  mime      String
  size      Int
  data      Bytes
  createdAt DateTime @default(now()) @map("created_at")

  @@map("stored_files")
}
