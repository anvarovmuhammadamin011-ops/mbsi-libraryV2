# ============================================================
# MBSI Library — Environment configuration (EXAMPLE)
# ============================================================
# 1) Nusxa oling:
#      PowerShell:  Copy-Item .env.example .env
#      macOS/Linux: cp .env.example .env
# 2) Qiymatlarni to'ldiring. `.env` ni HECH QACHON git'ga qo'shmang.
# 3) APP_SECRET ni generatsiya qilish:
#      node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
# ============================================================

# ────────────────────────────────────────────────────────────
# 1. ILOVA (CORE)
# ────────────────────────────────────────────────────────────
APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Sessiya va CSRF imzolari uchun kalit. Kamida 32 belgi, production'da majburiy.
APP_SECRET="change-me-with-a-random-string-at-least-32-characters"

# ────────────────────────────────────────────────────────────
# 2. MA'LUMOTLAR BAZASI (PostgreSQL)
# ────────────────────────────────────────────────────────────
# Lokal PostgreSQL:
#   createdb mbsi_library
# Neon/Supabase/Vercel Postgres uchun connection string'ni qo'ying.
# Pooler ishlatsangiz `?sslmode=require&pgbouncer=true` qo'shing.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mbsi_library?schema=public"

# (Ixtiyoriy) Neon kabi pooler uchun to'g'ridan-to'g'ri URL.
# Prisma migrate uchun ishlatiladi. Ishlatsangiz, `prisma/schema.prisma`
# ichidagi `directUrl` qatorini ham oching.
# DATABASE_URL_UNPOOLED="postgresql://user:password@host:5432/mbsi_library?sslmode=require"

# Prisma connection pool (serverless uchun muhim).
PRISMA_CONNECTION_LIMIT="10"
PRISMA_POOL_TIMEOUT="30"

# ────────────────────────────────────────────────────────────
# 3. RATE LIMITING (API himoyasi)
# ────────────────────────────────────────────────────────────
# O'chirish uchun RATE_LIMIT_ENABLED="false".
# READ_MAX — 1 daqiqada IP boshiga GET so'rovlari.
# MUTATION_MAX — 1 daqiqada IP boshiga POST/PUT/PATCH/DELETE.
RATE_LIMIT_ENABLED="true"
RATE_LIMIT_READ_MAX="600"
RATE_LIMIT_READ_WINDOW_MS="60000"
RATE_LIMIT_MUTATION_MAX="120"
RATE_LIMIT_MUTATION_WINDOW_MS="60000"

# ────────────────────────────────────────────────────────────
# 4. FAYL SAQLASH (PDF / muqovalar)
# ────────────────────────────────────────────────────────────
# auto  — S3 to'liq sozlangan bo'lsa S3, aks holda DB (stored_files)
# s3    — majburiy S3 / Cloudflare R2 / MinIO
# db    — Postgres BYTEA (serverless uchun ishonchli)
# local — server diskida `storage/private/` (faqat lokal/VPS)
STORAGE_DRIVER="auto"

# S3 / Cloudflare R2 (STORAGE_DRIVER=s3 yoki auto bo'lsa)
S3_BUCKET=""
S3_REGION=""
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_BASE_URL=""

# Lokal diskda bo'lmagan katta PDF'lar uchun zaxira manba.
# Masalan: https://github.com/<owner>/<repo>/releases/download/pdfs-v1
PDF_PUBLIC_BASE=""

# ────────────────────────────────────────────────────────────
# 5. DEMO AKKAUNTLAR
# ────────────────────────────────────────────────────────────
# `npm run db:accounts` shu parollardan foydalanadi.
# Bo'sh qoldirilsa — tasodifiy parol generatsiya qilinadi va
# faqat bir marta console'da ko'rsatiladi.
DEMO_PASSWORD_ADMIN="demo123"
DEMO_PASSWORD_STUDENT="demo123"
DEMO_PASSWORD_TEACHER="demo123"
DEMO_PASSWORD_STAFF="demo123"
DEMO_PASSWORD_KITOBMANAGER="demo123"
DEMO_PASSWORD_OQUVCHIMANAGER="demo123"

# ────────────────────────────────────────────────────────────
# 6. SUPABASE (ixtiyoriy — OAuth/email auth scaffold)
# ────────────────────────────────────────────────────────────
# Asosiy login custom session cookie orqali ishlaydi. Bu bo'lim
# faqat Supabase OAuth/email integratsiyasini sinash uchun.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# ────────────────────────────────────────────────────────────
# 7. FIREBASE CLOUD MESSAGING (ixtiyoriy — push)
# ────────────────────────────────────────────────────────────
# Bo'sh bo'lsa push o'chadi, ilovaning qolgan qismi ishlayveradi.
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=""
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""
NEXT_PUBLIC_FIREBASE_VAPID_KEY=""

# Server tomondan push yuborish uchun service account JSON (bir qatorda).
FIREBASE_SERVICE_ACCOUNT_JSON=""

# ────────────────────────────────────────────────────────────
# 8. AI (ixtiyoriy — kategoriya tavsiyasi / OCR)
# ────────────────────────────────────────────────────────────
AI_PROVIDER="groq"
AI_API_KEY=""
AI_MODEL="openai/gpt-oss-120b"

# ────────────────────────────────────────────────────────────
# 9. QIDIRUV (ixtiyoriy — Meilisearch)
# ────────────────────────────────────────────────────────────
# Bo'sh bo'lsa PostgreSQL fallback ishlaydi.
MEILI_HOST=""
MEILI_API_KEY=""
