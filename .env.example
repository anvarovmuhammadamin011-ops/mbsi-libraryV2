# MBSI Library — Environment (example)
# Copy to `.env` and fill values.
#
# DATABASE_URL must point at a PostgreSQL instance (Neon, Vercel
# Postgres, Supabase or local Postgres all work). SQLite is no
# longer supported because the app is deployed to serverless.
# Neon/Prisma uchun Vercel-da pooling URL ni `DATABASE_URL` (pooled),
# haqiqiy connection URL ni `DATABASE_URL_UNPOOLED` ga qo'ying.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
# (ixtiyoriy) Poolersiz to'g'ridan-to'g'ri DB URL — prisma migrate uchun.
# DATABASE_URL_UNPOOLED="postgresql://user:password@host/dbname?sslmode=require"
APP_SECRET="change-me-to-a-long-random-string"
APP_URL="http://localhost:3000"

# ─── Postgres connection pool ────────────────────────────────
# connection_limit — Prisma pool'dagi maksimal ulanishlar soni.
# pool_timeout (soniya) — pool band bo'lsa qancha kutish.
PRISMA_CONNECTION_LIMIT="10"
PRISMA_POOL_TIMEOUT="30"

# ─── Rate limiting (API himoyasi) ────────────────────────────
# RATE_LIMIT_ENABLED — o'chirib qo'yish uchun "false".
# RATE_LIMIT_READ_MAX: 1 daqiqada IP boshiga o'qish (GET) so'rovlari.
# RATE_LIMIT_MUTATION_MAX: 1 daqiqada IP boshiga o'zgartirish (POST/PUT...).
RATE_LIMIT_ENABLED="true"
RATE_LIMIT_READ_MAX="600"
RATE_LIMIT_READ_WINDOW_MS="60000"
RATE_LIMIT_MUTATION_MAX="120"
RATE_LIMIT_MUTATION_WINDOW_MS="60000"

# ─── AI (kitob tahlili, tarjima, yordamchi) ─────────────────
# AI_PROVIDER: "groq" (bepul, tavsiya) yoki "openai"
# AI_API_KEY: provider-ning API kaliti
#   Groq: https://console.groq.com (bepul)
#   OpenAI: https://platform.openai.com/api-keys
# AI_MODEL: ixtiyoriy. Groq uchun "openai/gpt-oss-120b" (kuchli), OpenAI uchun "gpt-4o-mini"
AI_PROVIDER="groq"
AI_API_KEY=""
AI_MODEL="openai/gpt-oss-120b"

# ─── Fayl storage ────────────────────────────────────────────
# STORAGE_DRIVER: "auto" (default) — S3 sozlangan bo'lsa S3 ishlaydi,
#                  aks holda DB (stored_files) ichida saqlaydi.
#                  "s3" — majburiy S3 (sozlanmasa xatolik),
#                  "local" — PDF/muqovalar server diskida (`storage/private/`),
#                            Postgres BYTEA'da EMAS (DB yengil qoladi).
#                  "db" — hammasi Postgres BYTEA'da (eski xulq).
STORAGE_DRIVER="auto"
# Cloudflare R2 (S3-mos) yoki AWS S3:
# S3_BUCKET="mbsi-library-files"
# S3_REGION="auto"
# S3_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# S3_PUBLIC_BASE_URL="https://cdn.example.com"

# PDF_PUBLIC_BASE �?" lokal diskda yo'q bo'lgan PDF kalitlari uchun zaxira
# manba. /api/pdf/[id] uni `PDF_PUBLIC_BASE/<fayl-nomi>` dan STREAM qiladi
# (4.5 MB chegarasi uchun buffer emas). GitHub Releases ideal:
#   https://github.com/<owner>/<repo>/releases/download/pdfs-v1
# Bo'sh qoldirilsa — faqat lokal disk + stored_files qidiriladi.
# PDF_PUBLIC_BASE=""

# ─── Demo akkaunt parollari (secret) ────────────────────────
# `node prisma/accounts-seed.mjs` bu parollarni ishlatadi. Repo'ga hech
# qachon plaintext parol yozilmaydi — faqat env orqali.
# Bo'lmasa: tasodifiy parol yaratilib, faqat bir marta console'da ko'rsatiladi.
# DEMO_PASSWORD_ADMIN="..."
# DEMO_PASSWORD_STUDENT="..."
# DEMO_PASSWORD_TEACHER="..."
# DEMO_PASSWORD_STAFF="..."
# DEMO_PASSWORD_KITOBMANAGER="..."
# DEMO_PASSWORD_OQUVCHIMANAGER="..."

# ─── O'qish sozlamalari ─────────────────────────────────────
# Kitobni "tamomlangan" deb hisoblash uchun eng kam o'qish vaqti (soniya).
# Default: 43200 (12 soat). Masalan 1 soat = 3600.
# MIN_READING_SECONDS="43200"

# MEILI_HOST="http://localhost:7700"
# MEILI_API_KEY=""