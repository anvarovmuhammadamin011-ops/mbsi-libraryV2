.env
.env.local
.env.development
.env.test
.env.production
.env.*.local
.env.vercel
# Namuna fayl esa albatta saqlanadi:
!.env.example

# ─── Vercel / Firebase / PM2 ────────────────────────────────
.vercel
.firebase/
firebase-debug.log
firebase-debug.*.log
*.pid
pm2-*.log

# ─── Prisma / DB ────────────────────────────────────────────
prisma/dev.db
prisma/dev.db-journal
prisma/*.db
prisma/*.db-journal

# ─── Private storage ────────────────────────────────────────
