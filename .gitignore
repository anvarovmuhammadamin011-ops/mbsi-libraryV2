!.yarn/releases
!.yarn/plugins
!.yarn/sdks
!.yarn/versions
.npm

# ─── Next.js / build ────────────────────────────────────────
/.next/
/out/
/build
.next
*.tsbuildinfo
next-env.d.ts

# ─── Environment (maxfiy!) ──────────────────────────────────
